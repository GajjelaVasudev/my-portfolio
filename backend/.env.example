# ==============================================================================
# RAG Personal Assistant — Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual settings.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# PostgreSQL + pgvector Database Connection URL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/portfolio_rag

# OpenAI API Key (or OpenAI-compatible provider)
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Custom OpenAI API Base URL (for Groq, Ollama, DeepSeek, OpenRouter, etc.)
# Leave blank to use official OpenAI endpoint: https://api.openai.com/v1
OPENAI_BASE_URL=

# Models Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Retrieval Settings
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.35

# Rate Limiting (queries per minute per client IP)
RATE_LIMIT_PER_MINUTE=20

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
