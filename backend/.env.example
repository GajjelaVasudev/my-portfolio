# ==============================================================================
# RAG Personal Assistant — Production Environment Configuration
# Copy this file to backend/.env and replace placeholders with your actual settings.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production

# Server Host & Port (Render automatically sets PORT at runtime)
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL + pgvector Database Connection URL
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Multi-Provider AI Configuration (Fallback Priority: Gemini -> OpenAI -> Groq)
# ------------------------------------------------------------------------------

# Primary Provider: Google Gemini
# Key can be set as GOOGLE_API_KEY or GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_TEMPERATURE=0.2
EMBEDDING_MOCK_MODE=false

# Fallback Provider 1: OpenAI (Optional)
# If OPENAI_API_KEY is empty or not set, this provider is automatically skipped.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback Provider 2: Groq (Optional)
# If GROQ_API_KEY is empty or not set, this provider is automatically skipped.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Per-provider request timeout in seconds
PROVIDER_TIMEOUT_SECONDS=12.0

# ------------------------------------------------------------------------------
# 3. Retrieval & Rate Limiting Settings
# ------------------------------------------------------------------------------
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.35
RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 4. CORS Origins (Restrict to Netlify Deployed Frontend and Localhost)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-portfolio.netlify.app
