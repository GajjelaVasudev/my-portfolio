# ==============================================================================
# RAG Personal Assistant — Production Environment Configuration (Google Gemini)
# Copy this file to backend/.env and replace placeholders with your actual settings.
# Never commit actual secret keys or credentials to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production

# Server Host & Port (Render automatically sets PORT at runtime)
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL + pgvector Database Connection URL
# ------------------------------------------------------------------------------
# Connection Pooling Mode (Transaction / Session on port 6543 / 5432):
# Format: postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres
# Or Direct Connection:
# Format: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Generation model: gemini-1.5-flash or gemini-2.0-flash
GEMINI_GENERATION_MODEL=gemini-1.5-flash

# Embedding model: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector dimension for gemini-embedding-001 (768 with output_dimensionality=768)
EMBEDDING_DIMENSION=768

# Mock mode for offline development/tests (never set to true in production)
EMBEDDING_MOCK_MODE=false

# Temperature for grounded generation (low temperature avoids creative liberties)
GEMINI_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 3. Retrieval & Rate Limiting Settings
# ------------------------------------------------------------------------------
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.35
RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 4. CORS Origins (Restrict to Netlify Deployed Frontend and Localhost)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Replace https://your-portfolio.netlify.app with your live Netlify domain.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-portfolio.netlify.app
